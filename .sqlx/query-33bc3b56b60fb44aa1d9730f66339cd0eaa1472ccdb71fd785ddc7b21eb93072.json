{
  "db_name": "PostgreSQL",
  "query": "WITH entities AS (SELECT status, id FROM core_psbt_sessions WHERE (status = $1) AND (id < $3) ORDER BY id DESC LIMIT $2) SELECT i.id AS \"entity_id: Repo__Id\", e.sequence, e.event, CASE WHEN $4 THEN e.context ELSE NULL::jsonb END as \"context: es_entity::ContextData\", e.recorded_at, NULL::jsonb as \"forgettable_payload?\" FROM entities i JOIN core_psbt_session_events e ON i.id = e.id ORDER BY i.id desc, i.id, e.sequence",
